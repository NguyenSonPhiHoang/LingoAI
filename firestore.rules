rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    //------------------------------------------------------------
    // Users Collection
    // Admins can read all user data.
    // Users can only read and update their own data.
    //------------------------------------------------------------
    match /users/{userId} {
      // READ: An admin can read any user's profile. A regular user can only read their own.
      allow get: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // LIST: Only admins can list all users.
      allow list: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // CREATE: A user can create their own user document upon signup.
      // Rules enforce that new users are assigned 'user' role and 'pending' status.
      allow create: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.data.role == 'user'
                    && request.resource.data.status == 'pending';

      // UPDATE: A user can update their own displayName/photoURL.
      // An admin can update any user's status.
      // No one can change the role field after creation.
      allow update: if request.auth != null && (
        // Case 1: User updating their own non-critical info
        (request.auth.uid == userId && 
         request.resource.data.keys().hasOnly(['displayName', 'photoURL'])) ||
        // Case 2: Admin updating another user's status
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
         request.resource.data.keys().hasOnly(['status']))
      );
    }
    
    //------------------------------------------------------------
    // Global Words Collection
    // All authenticated users can read. Only admins can write.
    //------------------------------------------------------------
    match /words/{wordId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    //------------------------------------------------------------
    // User-Specific Data Collections
    // Generic rule: A user can perform any action on documents 
    // where the document's `userId` field matches their own auth UID.
    //------------------------------------------------------------
    function isOwner() {
      return request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    match /userVocabulary/{docId} {
      allow read, write, delete: if isOwner();
    }
    
    match /lessons/{docId} {
      allow read, write, delete: if isOwner();
    }
    
    match /library/{docId} {
      allow read, write, delete: if isOwner();
    }
    
    match /testResults/{docId} {
      allow read, write, delete: if isOwner();
    }

    match /user_activity/{docId} {
      allow read, write, delete: if isOwner();
    }
  }
}
