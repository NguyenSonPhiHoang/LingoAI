rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check for admin role
    function isAdmin() {
      // Check the user's role by looking up their document in the 'users' collection.
      // This is secure because access to 'users' collection is controlled by rules below.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // READ: 
      // - Any authenticated user can GET another user's profile.
      // - Only admins can LIST all users.
      allow get: if request.auth.uid != null;
      allow list: if isAdmin();

      // CREATE: A user can only create their own user document.
      allow create: if request.auth.uid == userId;

      // UPDATE:
      // - A user can update their own document, BUT cannot change their role or status.
      // - An admin can update another user's status, but not their role.
      allow update: if (request.auth.uid == userId && 
                        request.resource.data.role == resource.data.role &&
                        request.resource.data.status == resource.data.status) ||
                       (isAdmin() && 
                        request.resource.data.role == resource.data.role);

      // DELETE: No one can delete user documents.
      allow delete: if false;
    }

    // Rules for the global 'words' collection
    match /words/{wordId} {
      // READ: Any authenticated user can read the global word list.
      allow read: if request.auth.uid != null;
      // WRITE: Only admins can create or update global words.
      allow write: if isAdmin();
    }
    
    // Function to check ownership for user-specific data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rules for all user-specific collections
    match /{collection}/{docId} {
      // This rule applies to: userVocabulary, lessons, testResults, user_activity, library
      allow read, write, delete: if collection in ['userVocabulary', 'lessons', 'testResults', 'user_activity', 'library'] && isOwner(resource.data.userId);
    }
    
    // Default deny all other access
    match /{path=**} {
      allow read, write: if false;
    }
  }
}