rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection:
    // - Allow users to read their own document.
    // - Allow users to update their own document.
    // - Allow admins to read/write any user document.
    // - Allow new users to create their own document.
    match /users/{userId} {
      allow read, update: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow create: if request.auth != null;
    }
    
    // Words collection (Global Vocabulary)
    // - Allow any authenticated user to read.
    // - Only allow admins to write (create/update/delete).
    match /words/{wordId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // UserVocabulary collection (Personalized word details)
    // - Allow users to read/write/delete their own vocabulary entries.
    match /userVocabulary/{userVocabId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /userVocabulary/{userVocabId} {
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Lessons collection
    // - Allow users to read/write their own lessons.
    match /lessons/{lessonId} {
        allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Learning Resources collection
    // - Allow any authenticated user to read resources.
    // - Allow authenticated users to UPDATE (for ratings).
    // - Create and delete should be restricted (admin-only, handled in backend logic).
    match /learningResources/{resourceId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow create, delete: if false; // Handled by backend logic/security functions for admin roles
    }
    
    // Test Results collection
    // - Allow users to read their own test results.
    // - Allow users to create new test results.
    match /testResults/{resultId} {
        allow read: if request.auth != null && request.auth.uid == resource.data.userId;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
     // User Activity collection
    match /user_activity/{activityId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
     // Library Documents
    match /library/{docId} {
      allow read, write: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == request.resource.data.userId;
    }
    
    // Library Content
    match /library_content/{contentId} {
       allow read, write: if request.auth.uid == resource.data.userId;
       allow create: if request.auth.uid == request.resource.data.userId;
    }
  }
}