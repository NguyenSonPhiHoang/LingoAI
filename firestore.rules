rules_version = '2';

// Cấp quyền truy cập vào Cloud Firestore
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if the user's account is approved
    function isApproved() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Any authenticated user can create their own user document
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Users can read their own data. Admins can read any user's data.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Users can update their own displayName. Admins can update anyone's status.
      allow update: if request.auth != null && 
                       ((request.auth.uid == userId && request.resource.data.keys().hasOnly(['displayName', 'photoURL'])) ||
                        (isAdmin() && request.resource.data.keys().hasOnly(['status'])));
    }

    // Rules for the global 'words' collection
    match /words/{wordId} {
      // Any approved user can read the global word list
      allow read: if request.auth != null && isApproved();
      
      // Admins can create new global words
      allow create: if isAdmin();
      
      // Admins can update global words (term, pronunciation, audioUrl)
      allow update: if isAdmin() && request.resource.data.keys().hasAll(['term', 'term_normalized', 'pronunciation']);
    }

    // Rules for the 'userVocabulary' collection (user-specific words)
    match /userVocabulary/{userVocabId} {
        // Users can read, create, update, and delete their own vocabulary entries,
        // but only if their account is approved.
        allow read, write: if request.auth != null && 
                              isApproved() &&
                              (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }
    
    // Rules for the 'lessons' collection
    match /lessons/{lessonId} {
        // Users can read, create, update, and delete their own lessons,
        // but only if their account is approved.
        allow read, write: if request.auth != null &&
                              isApproved() &&
                              (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    // Rules for the 'testResults' collection
    match /testResults/{testResultId} {
      // Users can only read their own test results.
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Users can only create test results for themselves.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}