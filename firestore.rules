
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Check if the user is an admin by looking up their user document.
      // Note: This requires a separate 'get' permission for admins on the users collection.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for 'users' collection
    match /users/{userId} {
      // Allow read access for any authenticated user. This is needed for isAdmin() to function.
      allow get: if request.auth.uid != null;
      // Allow list access only for admins.
      allow list: if isAdmin();
      // Allow users to update their own info, but not their role or status.
      // Allow admins to update anyone's status.
      allow write: if (request.auth.uid == userId && !('role' in request.resource.data) && !('status' in request.resource.data))
                   || (isAdmin() && !('role' in request.resource.data));
    }

    // Rules for 'words' (global vocabulary) collection
    match /words/{wordId} {
        // Anyone can read the global words list
        allow read: if request.auth.uid != null;
        // Only admins can create, update, or delete global words
        allow write: if isAdmin();
    }

    // Rules for 'userVocabulary' collection
    match /userVocabulary/{userVocabId} {
        // A user can read/write their own vocabulary entries.
        allow read, write: if request.auth.uid == resource.data.userId;
    }

    // Rules for 'lessons' collection
    match /lessons/{lessonId} {
        // A user can read/write their own lessons.
        allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    // Rules for 'testResults' collection
    match /testResults/{resultId} {
        // A user can read/create their own test results.
        allow read, create: if request.auth.uid == request.resource.data.userId;
    }

    // Rules for 'user_activity' collection
    match /user_activity/{activityId} {
        // Users can create/update their own activity logs.
        // Admins can read any activity log.
        allow create, update: if request.auth.uid == request.resource.data.userId;
        allow read: if request.auth.uid == resource.data.userId || isAdmin();
    }
    
    // Rules for 'learningResources' collection
    match /learningResources/{resourceId} {
        // Any authenticated user can read the resources.
        allow read: if request.auth.uid != null;
        
        // Allow admins to create/delete.
        allow create, delete: if isAdmin();
        
        // Allow any authenticated user to update, but ONLY the 'ratings' field for themselves.
        // This is a more secure way to handle ratings.
        allow update: if request.auth.uid != null
                      && request.resource.data.keys().hasOnly(['ratings', 'ratingCount', 'averageRating'])
                      && request.resource.data.ratings.diff(resource.data.ratings).affectedKeys().hasOnly([request.auth.uid]);
    }
    
    // Rules for 'library' collection
    match /library/{documentId} {
        // A user can read and write documents that belong to them.
        allow read, write: if request.auth.uid == resource.data.userId;
    }
  }
}
