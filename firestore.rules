rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read, update: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }
    
    match /lessons/{docId} { allow read, write: if request.auth.uid == resource.data.userId; }
    match /userVocabulary/{docId} { allow read, write: if request.auth.uid == resource.data.userId; }
    match /library/{docId} { allow read, write: if request.auth.uid == resource.data.userId; }
    match /library_content/{docId} { allow read, write: if request.auth.uid == resource.data.userId; }
    match /testResults/{docId} { allow read, write: if request.auth.uid == resource.data.userId; }
    match /user_activity/{docId} { allow read, write: if request.auth.uid == resource.data.userId; }

    match /storybooks/{docId} {
      // Allow list queries only when filtered by the user's own ID.
      // The application code in `getStorybooks` already includes this filter.
      allow list: if request.auth != null && request.query.where.left == "userId" && request.query.where.op == "==" && request.query.where.right == request.auth.uid;
      
      // Allow get, create, update, delete only for the owner of the document.
      allow get, update, delete: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == request.resource.data.userId;
    }

    match /words/{wordId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /learningResources/{resourceId} {
      allow read: if request.auth != null;
      // Allow create/delete for admin, allow update (for rating) for any authenticated user.
      allow create, delete: if isAdmin();
      allow update: if request.auth != null;
    }
  }
}
