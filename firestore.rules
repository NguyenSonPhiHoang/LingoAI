rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow admins to get any user document.
      // Allow authenticated users to get their own document.
      allow get: if isAdmin() || request.auth.uid == userId;

      // Allow admins to list all users. This is crucial for the User Management page.
      allow list: if isAdmin();

      // Allow authenticated users to create their own user document,
      // but they cannot assign themselves as admin or pre-approve themselves.
      allow create: if request.auth.uid == userId &&
                       request.resource.data.role == 'user' &&
                       request.resource.data.status == 'pending';

      // Allow users to update their own displayName and photoURL.
      // Admins can update any user's status.
      // No one can change the role field after creation except through manual DB edit.
      allow update: if (request.auth.uid == userId &&
                        request.resource.data.displayName == resource.data.displayName &&
                        request.resource.data.photoURL == resource.data.photoURL) ||
                       (isAdmin() &&
                        request.resource.data.status != resource.data.status);
    }
    
    // Rules for the global 'words' collection
    match /words/{wordId} {
      // Authenticated users can read and create (implicitly via addWordToVocabulary flow)
      allow get, create: if request.auth.uid != null;
      // Only admins can update the global word entries (e.g., term, pronunciation, audioUrl)
      allow update: if isAdmin();
    }
    
    // Rules for user-specific data collections
    match /userVocabulary/{docId} {
      allow read, write, delete: if request.auth.uid == resource.data.userId;
    }
    
    match /lessons/{docId} {
       allow read, write, delete: if request.auth.uid == resource.data.userId;
    }
    
    match /testResults/{docId} {
       allow read, write, delete: if request.auth.uid == resource.data.userId;
    }
    
    match /user_activity/{docId} {
       allow read, write, delete: if request.auth.uid == resource.data.userId;
    }

    match /library/{docId} {
      // A user can perform any action (read, write, delete) on a library document
      // if and only if their UID matches the userId stored in that document.
      allow read, write, delete: if request.auth.uid == resource.data.userId;
    }
  }
}
