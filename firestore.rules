rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // READ:
      // - Admins can read any user profile.
      // - Any authenticated user can read their own profile.
      allow get: if request.auth != null && (isAdmin() || request.auth.uid == userId);
      allow list: if request.auth != null && isAdmin();

      // CREATE:
      // - Any authenticated user can create their own user document.
      // - The role must be 'user' and status 'pending' upon creation.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'pending';

      // UPDATE:
      // - Admins can update the 'status' of any user.
      // - Any authenticated user can update their own 'displayName' and 'photoURL'.
      // - Users CANNOT change their own role or status.
      allow update: if request.auth != null && (
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
        (request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']))
      );
    }

    // Rules for the 'words' (global vocabulary) collection
    match /words/{wordId} {
        // Anyone authenticated can read. Anyone can create a new word (e.g., when adding a word not in the DB).
        allow get, list, create: if request.auth != null;
        // Only admins can update the base word properties.
        allow update: if request.auth != null && isAdmin();
    }

    // Rules for user-specific collections
    match /{collection}/{docId}
      where collection in ['userVocabulary', 'lessons', 'testResults', 'user_activity', 'library'] {
      // A user can do anything with documents that belong to them.
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      // A user can only create documents for themselves.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
  }
}
