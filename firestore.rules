rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper function to check for admin role from token ---
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    // --- Helper function to check if user is the owner of the data ---
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Users Collection ---
    // Users can read their own data. Admins can read/list all users.
    // Users can create their own document.
    // Users can only update their own displayName and photoURL.
    // Admins can update any user's status.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'user'
                    && request.resource.data.status == 'pending';
      allow update: if (isOwner(userId) && request.resource.data.keys().hasOnly(['displayName', 'photoURL']))
                    || (isAdmin() && request.resource.data.keys().hasOnly(['status']));
    }

    // --- Global Words Collection ---
    // Any authenticated user can read/create. Only admins can update global words.
    match /words/{wordId} {
      allow read, create: if request.auth != null;
      allow update: if isAdmin();
    }

    // --- User-specific Vocabulary Collection ---
    // Users can only manage their own vocabulary entries.
    match /userVocabulary/{userVocabId} {
      allow read, write, delete: if request.auth != null && isOwner(request.resource.data.userId);
    }

    // --- Lessons Collection ---
    // Users can only manage their own lessons.
    match /lessons/{lessonId} {
       allow read, write, delete: if request.auth != null && isOwner(request.resource.data.userId);
    }

    // --- Library Collection ---
    // Users can only manage their own library documents.
    match /library/{documentId} {
       allow read, write, delete: if request.auth != null && isOwner(request.resource.data.userId);
    }

    // --- Test Results Collection ---
    // Users can only manage their own test results.
    match /testResults/{resultId} {
       allow read, write, delete: if request.auth != null && isOwner(request.resource.data.userId);
    }

    // --- User Activity Collection ---
    // Users can only manage their own activity logs.
    match /user_activity/{activityId} {
       allow read, write, delete: if request.auth != null && isOwner(request.resource.data.userId);
    }

    // --- Default deny rule ---
    // Any other path not explicitly matched above will be denied.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}