rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function for admin check
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // USERS:
    // - Authenticated users can create their own user document.
    // - Users can only read/update their own document.
    // - Admins can read all user documents.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // SHARED RESOURCES:
    // - Authenticated users can read.
    // - Admins can write.
    match /learningResources/{docId} {
       allow read: if request.auth != null;
       allow write: if request.auth != null && isAdmin();
    }
    match /words/{docId} {
       allow read: if request.auth != null;
       allow write: if request.auth != null && isAdmin();
    }
    
    // USER-OWNED CONTENT:
    // - Users can read/write their own documents.
    // - Admins can read all documents.
    function isOwner() {
        return request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /lessons/{docId} {
        allow read: if isOwner() || isAdmin();
        allow write: if isOwner();
    }
    match /storybooks/{docId} {
        allow read: if isOwner() || isAdmin();
        allow write: if isOwner();
    }
    match /library/{docId} {
        allow read: if isOwner() || isAdmin();
        allow write: if isOwner();
    }
     match /library_content/{docId} {
        allow read: if isOwner() || isAdmin();
        allow write: if isOwner();
    }
    match /userVocabulary/{docId} {
        allow read: if isOwner() || isAdmin();
        allow write: if isOwner();
    }
    match /testResults/{docId} {
        allow read: if isOwner() || isAdmin();
        allow write: if isOwner();
    }
    match /user_activity/{docId} {
        allow read: if isOwner() || isAdmin();
        allow write: if isOwner();
    }
  }
}
