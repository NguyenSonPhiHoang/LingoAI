rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection:
    // - Anyone can create their own user document upon signup.
    // - Only the user themselves or an admin can read/update their own document.
    // - Admins can read/write any user document.
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow create: if request.auth.uid == userId;
      // Admins can list users.
      allow list: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Lessons collection:
    // - Users can create, read, update, and delete their own lessons.
    match /lessons/{lessonId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }

    // Vocabulary collections:
    // - The 'words' collection is global. Any authenticated user can read from it. Only admins can write.
    match /words/{wordId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // - The 'userVocabulary' collection is user-specific. Users can manage their own entries.
    match /userVocabulary/{userVocabId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }

    // Learning Resources:
    // - Any authenticated user can read and update (for rating) resources.
    // - Only admins can create and delete resources.
    match /learningResources/{resourceId} {
      allow read, update: if request.auth != null;
      allow create, delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // User Activity:
    // - A user can only write to their own activity log.
    // - Admins can read anyone's activity log for analytics.
    match /user_activity/{activityId} {
        allow create, update: if request.auth.uid == request.resource.data.userId;
        allow read: if request.auth.uid == resource.data.userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow list: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Test Results:
    // - A user can create and read their own test results.
    // - Admins can read all test results.
    match /testResults/{resultId} {
        allow create: if request.auth.uid == request.resource.data.userId;
        allow read: if request.auth.uid == resource.data.userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Library and Library Content
    // A user can manage their own library documents and content.
    match /library/{docId} {
        allow read, write: if request.auth.uid == resource.data.userId;
    }
    match /library_content/{contentId} {
        allow read, write: if request.auth.uid == resource.data.userId;
    }
  }
}
