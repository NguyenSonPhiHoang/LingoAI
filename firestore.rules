rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Ensure the user document exists before trying to access data.
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // Admins can list and read all users. Users can only read their own data.
      allow read, list: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Anyone can create their own user document upon signup,
      // but role must be 'user' and status must be 'pending'.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == 'user'
                    && request.resource.data.status == 'pending';

      // Users can only update their own displayName and photoURL.
      // Admins can only update other users' status.
      allow update: if request.auth != null && (
                      (request.auth.uid == userId && request.resource.data.keys().hasOnly(['displayName', 'photoURL'])) ||
                      (isAdmin() && request.resource.data.keys().hasOnly(['status']))
                    );
    }

    match /words/{wordId} {
      // Any authenticated user can read or create a global word.
      allow read, create: if request.auth != null;
      // Only admins can update a global word's properties.
      allow update: if request.auth != null && isAdmin();
    }

    match /userVocabulary/{docId} {
      // Users can only manage their own vocabulary entries.
      allow read, write, delete: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /lessons/{lessonId} {
      // Users can only manage their own lessons.
      allow read, write, delete: if request.auth.uid == resource.data.userId;
    }
    
    match /library/{documentId} {
      // Users can only manage their own library documents.
      allow read, write, delete: if request.auth.uid == resource.data.userId;
    }

    match /testResults/{resultId} {
      // Users can only manage their own test results.
      allow read, write: if request.auth.uid == resource.data.userId;
    }

    match /user_activity/{activityId} {
       // Users can only read and update their own activity logs.
       // Create/delete is disallowed to prevent spoofing.
      allow read, write: if request.auth.uid == resource.data.userId;
    }
  }
}
