rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read their own user doc, but anyone can create one (signup).
    // Admins can read/write any user doc.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      // Admin override for status changes etc.
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Lessons are private to the user who created them.
    match /lessons/{docId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }

    // Storybooks are private to the user who created them.
    match /storybooks/{docId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }

    // Library documents are private to the user.
    match /library/{docId} {
        allow read, write: if request.auth.uid == resource.data.userId;
    }

    // Library content (notes) are private to the user.
    match /library_content/{docId} {
        allow read, write: if request.auth.uid == resource.data.userId;
    }

    // Words are public to read, but only admins can write.
    match /words/{docId} {
        allow read: if request.auth != null;
        allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User-specific vocabulary entries are private.
    match /userVocabulary/{docId} {
        allow read, write: if request.auth.uid == resource.data.userId;
    }

    // Learning resources are public to read, but only admins can write.
    match /learningResources/{docId} {
        allow read: if request.auth != null;
        allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Test results are private to the user.
    match /testResults/{docId} {
         allow read, write: if request.auth.uid == resource.data.userId;
    }

    // User activity logs are private to the user.
    match /user_activity/{docId} {
        allow read, write: if request.auth.uid == resource.data.userId;
    }
  }
}
