
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if a user is authenticated and approved.
    function isApprovedUser(userId) {
      return request.auth != null && request.auth.uid == userId && get(/databases/$(database)/documents/users/$(userId)).data.status == 'approved';
    }

    // Helper function to check if the user is an admin.
    function isAdmin(userId) {
        return request.auth != null && get(/databases/$(database)/documents/users/$(userId)).data.role == 'admin';
    }

    // Users can read and update their own profile information.
    // User creation is handled by the signup function.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      // Only admins can change status or roles.
      allow update: if isAdmin(request.auth.uid) && !('displayName' in request.resource.data && 'photoURL' in request.resource.data);
    }

    // Any approved user can create new base words.
    // Only admins can update existing base words.
    match /words/{wordId} {
      allow read, create: if isApprovedUser(request.auth.uid);
      allow update: if isAdmin(request.auth.uid);
    }

    // Users can manage their own vocabulary entries.
    match /userVocabulary/{userVocabId} {
      allow read, create, update, delete: if resource.data.userId == request.auth.uid || (request.resource != null && request.resource.data.userId == request.auth.uid);
    }

    // Users can manage their own lessons.
    match /lessons/{lessonId} {
      allow read, create, update, delete: if resource.data.userId == request.auth.uid || (request.resource != null && request.resource.data.userId == request.auth.uid);
    }
  }
}
