
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if a user is the owner of a resource
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users collection
    // - Authenticated users can read their own data.
    // - Admins can read/write any user's data.
    // - Users can create their own user document on signup.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
      allow create: if isOwner(userId);
    }

    // Words collection (Global vocabulary)
    // - Any authenticated user can read the global list of words.
    // - Only admins can create, update, or delete global words.
    match /words/{wordId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // UserVocabulary collection (Personalized vocabulary for each user)
    // - Users can only CRUD their own vocabulary entries.
    match /userVocabulary/{userVocabId} {
      allow read, write, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Lessons collection
    // - Users can only CRUD their own lessons.
    match /lessons/{lessonId} {
       allow read, write, delete: if request.auth != null && resource.data.userId == request.auth.uid;
       allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Library collection
    // - Users can only CRUD their own library documents.
    match /library/{docId} {
       allow read, write, delete: if request.auth != null && resource.data.userId == request.auth.uid;
       allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Library Content collection
    // - Users can only CRUD the content associated with their own library documents.
    match /library_content/{contentId} {
       allow read, write, delete: if request.auth != null && resource.data.userId == request.auth.uid;
       allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Learning Resources collection
    // - Any authenticated user can read the list of resources.
    // - Only admins can create/delete resources.
    // - Any authenticated user can update a resource (for rating).
    match /learningResources/{resourceId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if request.auth != null; // Allows any logged-in user to rate
    }

    // Test Results collection
    // - Users can read and create their own test results.
    match /testResults/{resultId} {
       allow read: if request.auth != null && resource.data.userId == request.auth.uid;
       allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // User Activity collection
    // - Users can create and update their own activity documents.
    match /user_activity/{activityId} {
       allow read, write: if request.auth != null && request.auth.uid == activityId.split('_')[0];
    }
  }
}
