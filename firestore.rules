rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getUserData(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData(request.auth.uid).role == 'admin';
    }

    // USER DATA: Users can read/write their own data. Admins can read all user data.
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow list: if isAdmin();
    }
    
    // LESSONS: Users can only read/write their own lessons.
    match /lessons/{lessonId} {
      allow read, write, delete: if isSignedIn() && isOwner(request.resource.data.userId);
      allow list: if isSignedIn(); // Users can list lessons, but Firestore rules will filter by userId in the query.
    }
    
    // TEST RESULTS: Users can only read/write their own test results.
    match /testResults/{resultId} {
        allow read, write, delete: if isSignedIn() && isOwner(request.resource.data.userId);
        allow list: if isSignedIn();
    }
    
    // USER ACTIVITY: Users can create/update their own activity. Admins can list all activity.
    match /user_activity/{activityId} {
        allow read, write: if isSignedIn() && isOwner(request.resource.data.userId);
        allow list: if isAdmin();
    }
    
    // GLOBAL WORDS: Read-only for all signed-in users. Writable only by Admins.
    match /words/{wordId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }
    
    // USER VOCABULARY: Users can only manage their own vocabulary list.
    match /userVocabulary/{userVocabId} {
      allow read, write, delete: if isSignedIn() && isOwner(request.resource.data.userId);
      allow list: if isSignedIn();
    }
  }
}