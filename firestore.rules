rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check for admin role
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can read/update their own data. Admins can do anything.
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
      allow list, create, delete: if isAdmin();
    }

    // Collections where users can only access their own documents
    match /lessons/{docId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    match /storybooks/{docId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }

    match /userVocabulary/{docId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    match /library/{docId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    match /library_content/{docId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    match /testResults/{docId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }

    match /user_activity/{docId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }

    // Global collections that are read-only for users, writable by admin
    match /words/{wordId} {
      allow read: if request.auth.uid != null;
      allow write: if isAdmin();
    }
    
    match /learningResources/{resourceId} {
        allow read: if request.auth.uid != null;
        // Writing (add, update, delete) handled by service-side logic/admin check
        allow write: if isAdmin();
    }
  }
}