rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if the user is the owner of the data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // READ:
      // - Admins can read any user profile.
      // - Users can read their own profile.
      allow get: if isOwner(userId) || isAdmin();

      // LIST:
      // - Admins can list all users to manage them.
      allow list: if isAdmin();

      // CREATE:
      // - Any authenticated user can create their own user document.
      // - Enforces default role 'user' and status 'pending' upon creation.
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'user'
                    && request.resource.data.status == 'pending';

      // UPDATE:
      // - Users can only update their own displayName and photoURL.
      // - Users cannot change their own role or status.
      // - Admins can update any user's status.
      allow update: if (isOwner(userId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']))
                    || (isAdmin()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
    }

    // Rules for the global 'words' collection
    match /words/{wordId} {
      // READ, CREATE: Any authenticated user can read words or create new ones
      // (a new word is created when a user adds a term not already in the db).
      allow read, create: if request.auth != null;

      // UPDATE: Only admins can edit global word properties like term and pronunciation.
      allow update: if isAdmin();
    }

    // Rules for user-specific vocabulary
    match /userVocabulary/{docId} {
      // Users can read, write, and delete their own vocabulary entries.
      allow read, write, delete: if isOwner(resource.data.userId);
    }

    // Rules for user's lessons
    match /lessons/{docId} {
       // Users can read, write, and delete their own lessons.
      allow read, write, delete: if isOwner(resource.data.userId);
    }

    // Rules for user's test results
    match /testResults/{docId} {
       // Users can read and create their own test results. Deletion/update is disallowed.
      allow read, create: if isOwner(request.resource.data.userId);
    }

    // Rules for user's activity log
    match /user_activity/{docId} {
       // Users can read their own activity and create/update their activity log.
      allow read, write: if isOwner(resource.data.userId);
    }
  }
}