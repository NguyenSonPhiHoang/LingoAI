
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // UTILS: Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // RULES
    match /users/{userId} {
      allow get, update: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
    }
    
    match /words/{wordId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }
    
    match /learningResources/{resourceId} {
        allow read: if isSignedIn();
        // Allow create/delete for admin, allow update (for rating) for any user
        allow create, delete: if isAdmin();
        allow update: if isSignedIn();
    }

    // User-specific collections
    match /userVocabulary/{docId} {
      allow get, write: if isSignedIn() && isOwner(resource.data.userId);
      allow list: if isSignedIn() && request.query.where.userId == request.auth.uid;
    }
    
    match /lessons/{docId} {
      allow get, write: if isSignedIn() && isOwner(resource.data.userId);
      allow list: if isSignedIn() && request.query.where.userId == request.auth.uid;
    }
    
    match /storybooks/{docId} {
      allow get, write: if isSignedIn() && isOwner(resource.data.userId);
      allow list: if isSignedIn() && request.query.where.userId == request.auth.uid;
    }
    
    match /library/{docId} {
      allow get, write: if isSignedIn() && isOwner(resource.data.userId);
      allow list: if isSignedIn() && request.query.where.userId == request.auth.uid;
    }
    
    match /library_content/{docId} {
      allow get, write: if isSignedIn() && isOwner(resource.data.userId);
      allow list: if isSignedIn() && request.query.where.userId == request.auth.uid;
    }
    
    match /testResults/{docId} {
      allow get, write: if isSignedIn() && isOwner(resource.data.userId);
      allow list: if isSignedIn() && request.query.where.userId == request.auth.uid;
    }
    
    match /user_activity/{docId} {
      allow get, write: if isSignedIn() && isOwner(resource.data.userId);
      allow list: if isSignedIn() && request.query.where.userId == request.auth.uid;
    }
  }
}
