
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin.
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Users can read and update their own profile.
      // Admins can read any profile and update any user's status/role.
      allow read: if request.auth.uid == userId || isAdmin();
      allow update: if request.auth.uid == userId || isAdmin();
      // Only admins can create or delete user records directly.
      allow create, delete: if isAdmin();
    }

    // Rules for the global 'words' collection
    match /words/{wordId} {
      // Any authenticated user can read the global word list.
      allow read: if request.auth.uid != null;
      // Only admins can write (create, update, delete) to the global word list.
      allow write: if isAdmin();
    }

    // Rules for the user-specific 'userVocabulary' collection
    match /userVocabulary/{userVocabId} {
      // Users can only read and write their own vocabulary entries.
      allow read, write: if request.auth.uid == request.resource.data.userId;
    }
    
    // Rules for the user-specific 'lessons' collection
    match /lessons/{lessonId} {
      // Users can only read and write their own lessons.
      allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    // Rules for the user-specific 'library' collection
    match /library/{documentId} {
        // A user can read and write to a document if they are the owner.
        // Admins can read and write to any document.
        allow read, write: if request.auth.uid == resource.data.userId || isAdmin();
    }
    
    // Rules for user activity tracking
    match /user_activity/{activityId} {
        // Users can only create/update their own activity logs.
        allow write: if request.auth.uid == request.resource.data.userId;
        // Only admins should be able to read all activity logs.
        allow read: if isAdmin();
    }
    
    // Rules for global learning resources
    match /learningResources/{resourceId} {
        // Any authenticated user can read resources.
        allow read: if request.auth.uid != null;
        
        // Only admins can create or delete resources.
        allow create, delete: if isAdmin();
        
        // Allow users to update a resource ONLY to add/change their own rating.
        // Admins can update any field.
        allow update: if isAdmin() || (
          request.auth.uid != null &&
          // The only fields being changed are ratings, ratingCount, averageRating
          request.resource.data.keys().diff(resource.data.keys()).hasOnly(['ratings', 'ratingCount', 'averageRating']) &&
          // The user is only changing their own rating
          request.resource.data.ratings.diff(resource.data.ratings).affectedKeys().hasOnly([request.auth.uid])
        );
    }
    
    // Rules for test results
    match /testResults/{resultId} {
        // Users can create their own test results.
        allow create: if request.auth.uid == request.resource.data.userId;
        // Users can only read their own test results. Admins can read all.
        allow read: if request.auth.uid == resource.data.userId || isAdmin();
        // Nobody can update or delete test results to preserve history.
        allow update, delete: if false;
    }
  }
}
