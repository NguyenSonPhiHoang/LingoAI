rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own data, but any authenticated user can read public profiles.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if false; // Users cannot delete their accounts this way
    }

    // Lessons belong to users.
    match /lessons/{lessonId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow list: if request.auth != null && request.query.where.size == 1 && request.query.where[0].field == 'userId' && request.query.where[0].value == request.auth.uid;
    }

    // Global word list - any authenticated user can read from it.
    match /words/{wordId} {
      allow read: if request.auth != null;
      // Only admins can create or update global words.
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User-specific vocabulary data, linking a user to a global word.
    match /userVocabulary/{userVocabularyId} {
      allow read, create, update, delete: if request.auth.uid == resource.data.userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // Allow a user to query for their own vocabulary items.
      // This is more secure than a blanket read rule.
      allow list: if request.auth != null && request.query.where.size == 1 && request.query.where[0].field == 'userId' && request.query.where[0].value == request.auth.uid;
    }
  }
}
