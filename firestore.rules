rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read; // Admins need to read user lists, users need to read their own data.
      allow update: if isSignedIn() && isOwner(userId); // Users can only update their own document.
      allow create: if isSignedIn(); // Allow new user signup to create their doc.
    }

    // Words collection (Global vocabulary)
    match /words/{wordId} {
      allow read: if isSignedIn(); // All signed-in users can read the global word list.
      allow write: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; // Only admins can write to the global word list.
    }

    // UserVocabulary collection (User-specific vocabulary data)
    match /userVocabulary/{userVocaId} {
      allow read, delete: if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && isOwner(request.resource.data.userId);
    }
    
    // Lessons collection
    match /lessons/{lessonId} {
       allow read, write: if isSignedIn() && isOwner(request.resource.data.userId);
       allow create: if isSignedIn() && isOwner(request.resource.data.userId);
       // For updates, we should also check against existing data
       allow update: if isSignedIn() && isOwner(resource.data.userId);
       allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }
    
    // Test Results collection
    match /testResults/{resultId} {
      allow read, create: if isSignedIn() && isOwner(request.resource.data.userId);
    }

    // User Activity collection
    match /user_activity/{activityId} {
      // Users can only write to their own activity log, identified by the document ID format "userId_date"
      allow write: if isSignedIn() && request.auth.uid == activityId.split('_')[0];
    }
  }
}
