rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: Can read/update their own profile. Admins can list/update any profile.
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
      allow list: if request.auth.uid != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Lessons: Users can fully manage their own lessons.
    match /lessons/{lessonId} {
      allow read, update, delete: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == request.resource.data.userId;
    }

    // Library Documents: Users can manage their own library documents.
    match /library/{docId} {
       allow read, update, delete: if request.auth.uid == resource.data.userId;
       allow create: if request.auth.uid == request.resource.data.userId;
    }
    
    // Library Content (Notes): Users can manage their own notes.
    match /library_content/{contentId} {
      allow read, update, delete: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == request.resource.data.userId;
    }

    // Global Words: Authenticated users can read. Admins can write.
    match /words/{wordId} {
      allow read: if request.auth.uid != null;
      // Allow create only if the term doesn't exist yet. This is a bit tricky
      // with security rules, so we handle it more robustly in backend logic.
      // For now, allow create for any logged-in user.
      allow create: if request.auth.uid != null;
      allow update: if request.auth.uid != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User Vocabulary: Users can manage their own vocabulary list.
    match /userVocabulary/{userVocabId} {
      allow read, update, delete: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == request.resource.data.userId;
    }

    // Test Results: Users can manage their own test results.
    match /testResults/{resultId} {
       allow read: if request.auth.uid == resource.data.userId;
       allow create: if request.auth.uid == request.resource.data.userId;
       // Generally, results should be immutable.
       allow update, delete: if false;
    }

    // Learning Resources: Authenticated users can read. Admins can manage.
    match /learningResources/{resourceId} {
      allow read: if request.auth.uid != null;
      // Allow rating (update) for authenticated users.
      allow update: if request.auth.uid != null; 
      allow create, delete: if request.auth.uid != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // User Activity: Users can only create/update their own activity logs.
    match /user_activity/{activityId} {
      // Users can only write to their own activity log, identified by docId format '{userId}_...'
      allow write: if request.auth.uid != null && request.auth.uid == split(activityId, '_')[0];
      // Only admins can read activity logs for analytics. Users cannot read their own raw logs.
      allow read: if request.auth.uid != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}