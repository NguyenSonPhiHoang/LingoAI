
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Users Collection
    // - Allow users to read any profile (for display names, etc.)
    // - Allow users to create their own profile
    // - Allow users to update ONLY their own profile
    // - Allow admin to update any profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Words Collection (Global Vocabulary)
    // - Allow any authenticated user to read the global word list.
    // - Only admins can create, update, or delete global words.
    match /words/{wordId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User Vocabulary Collection (Personalized words for each user)
    // - Users can only read, create, update, or delete their own vocabulary entries.
    match /userVocabulary/{userVocalId} {
        allow read, write: if request.auth.uid == request.resource.data.userId;
        allow delete: if request.auth.uid == resource.data.userId;
    }
    
    // Lessons Collection
    // - Users can only read, create, update, or delete their own lessons.
    match /lessons/{lessonId} {
        allow read, write, delete: if request.auth.uid == resource.data.userId;
    }
  }
}
