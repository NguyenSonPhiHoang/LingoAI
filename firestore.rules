
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // By default, deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Users collection rules
    match /users/{userId} {
      // A user can read and update their own profile
      allow read, update: if request.auth.uid == userId;
      // An admin can read and update any user's status/role
      allow read, update: if isAdmin();
      // Only admins can create or delete user records directly (usually handled by auth)
      allow create, delete: if isAdmin();
    }
    
    // Global words collection rules
    match /words/{wordId} {
      // Any authenticated user can read the global words list
      allow read: if request.auth != null;
      // Only admins can create or update global word definitions
      allow create, update: if isAdmin();
    }

    // User-specific vocabulary collection
    match /userVocabulary/{userVocabId} {
      // A user can do anything with their own vocabulary entries
      allow read, write: if request.auth.uid == resource.data.userId;
      // Admin can view any user's vocabulary (for support, etc.)
      allow read: if isAdmin();
    }

    // Lessons collection rules
    match /lessons/{lessonId} {
      // A user can do anything with their own lessons
      allow read, write: if request.auth.uid == resource.data.userId;
      // Admin can view any user's lessons
      allow read: if isAdmin();
    }
    
    // Library collection rules
    match /library/{docId} {
        // A user can manage their own library documents
        allow read, write: if request.auth.uid == resource.data.userId;
        // Admins have full access
        allow read, write: if isAdmin();
    }

    // Library content (notes) collection rules
    match /library_content/{contentId} {
        // A user can manage their own library content
        allow read, write: if request.auth.uid == resource.data.userId;
        // Admins have full access
        allow read, write: if isAdmin();
    }
    
    // Learning Resources (shared content)
    match /learningResources/{resourceId} {
      // Any authenticated user can read the resources
      allow read: if request.auth != null;
      // Only admins can add or fully update/delete resources
      allow create, delete: if isAdmin();
      // Allow authenticated users to update, but only the 'ratings' field for themselves
      allow update: if request.auth != null &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['ratings', 'ratingCount', 'averageRating']);
    }
    
    // Test Results collection
    match /testResults/{resultId} {
      // Users can create their own test results
      allow create: if request.auth.uid == request.resource.data.userId;
      // Users can only read their own test results
      allow read: if request.auth.uid == resource.data.userId;
    }
    
    // User Activity collection
    match /user_activity/{activityId} {
      // A user can only create/update their own activity log
      allow write: if request.auth.uid == request.resource.data.userId;
      // Only admins can read activity logs (for analytics, etc.)
      allow read: if isAdmin();
    }
  }
}
