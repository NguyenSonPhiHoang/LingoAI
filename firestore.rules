rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Check if the user document exists and if their role is 'admin'.
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // READ: An admin can read any user's document. A regular user can only read their own.
      allow read: if request.auth.uid == userId || isAdmin();
      
      // LIST: Only admins can list all users. This is crucial for the User Management view.
      allow list: if isAdmin();

      // CREATE: Any authenticated user can create their own user document upon signup.
      // The role must be 'user' and status must be 'pending' by default.
      allow create: if request.auth.uid != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == 'user'
                    && request.resource.data.status == 'pending';

      // UPDATE: A user can only update their own displayName and photoURL.
      // An admin can only update another user's 'status'.
      allow update: if (request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']))
                    || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
    }

    // Rules for the global 'words' collection
    match /words/{wordId} {
      // Anyone authenticated can read from the global word list.
      allow read: if request.auth.uid != null;
      // Anyone can create a new global word if it doesn't exist (e.g., when adding a new word).
      allow create: if request.auth.uid != null;
      // Only admins can update the canonical term and pronunciation.
      allow update: if isAdmin();
    }

    // Rules for user-specific collections
    match /userVocabulary/{docId} {
      allow read, write, delete: if request.auth.uid == resource.data.userId;
    }

    match /lessons/{docId} {
      allow read, write, delete: if request.auth.uid == resource.data.userId;
    }
    
    match /testResults/{docId} {
       allow read, create: if request.auth.uid == resource.data.userId;
       // Generally, results should be immutable.
       allow update, delete: if false;
    }
    
    match /user_activity/{docId} {
        // Users can only create/update their own activity log.
        allow write: if request.auth.uid == request.resource.data.userId;
        // Only admins should be able to read activity logs (for analytics).
        allow read: if isAdmin();
    }
  }
}
