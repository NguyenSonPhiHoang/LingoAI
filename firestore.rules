rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helper Functions ---
    // Function to check if the requesting user is an admin.
    function isAdmin() {
      // This checks the user's document in Firestore for the 'admin' role.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Collection Rules ---

    // Rules for the 'users' collection
    match /users/{userId} {
      // READ:
      // - A user can read their own document.
      // - An admin can read any user's document (for get and list operations).
      allow read: if request.auth.uid == userId || isAdmin();

      // CREATE:
      // - Any authenticated user can create their own user document.
      // - Important: Enforce default role as 'user' and status as 'pending' on creation.
      allow create: if request.auth.uid == userId
                    && request.resource.data.role == 'user'
                    && request.resource.data.status == 'pending';

      // UPDATE:
      // - A user can update their own displayName and photoURL.
      // - They CANNOT change their own role or status.
      // - An admin can update any user's status.
      allow update: if (request.auth.uid == userId && request.resource.data.keys().hasOnly(['displayName', 'photoURL']))
                    || (isAdmin() && request.resource.data.keys().hasOnly(['status']));
    }

    // Rules for the global 'words' collection
    match /words/{wordId} {
      // Anyone authenticated can read or create global words.
      allow read, create: if request.auth.uid != null;
      // Only admins can update the global word entries (e.g., fix a typo).
      allow update: if isAdmin();
    }

    // Rules for user-specific collections
    // This single rule applies to all collections where documents are owned by a user.
    match /{collection}/{docId} {
      allow read, write, delete: if request.auth.uid != null
                                  && request.auth.uid == resource.data.userId
                                  && (collection == 'lessons'
                                      || collection == 'userVocabulary'
                                      || collection == 'testResults'
                                      || collection == 'user_activity'
                                      || collection == 'library');
    }
  }
}