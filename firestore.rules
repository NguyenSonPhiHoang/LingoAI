rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users Collection: Manages user profiles, roles, and status.
    match /users/{userId} {
      // READ:
      // - A user can read their own profile.
      // - An admin can read any user's profile.
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // CREATE:
      // - A user can create their own document upon signup.
      // - Ensures the role is 'user' and status is 'pending' upon creation.
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == 'user'
                    && request.resource.data.status == 'pending';
      
      // UPDATE:
      // - A user can update their own displayName and photoURL.
      // - An admin can update another user's status.
      // - Crucially, users cannot change their own role or status.
      allow update: if request.auth != null && (
        ( // User-specific updates
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL'])
        ) ||
        ( // Admin-specific updates
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status'])
        )
      );

      // DELETE: No one can delete user documents for data integrity.
      allow delete: if false;
    }

    // Global Words Collection: Stores the base vocabulary terms.
    match /words/{wordId} {
      // READ/CREATE: Any authenticated user can read or create a new word.
      // A new word is created when a user adds a term not already in the system.
      allow read, create: if request.auth != null;

      // UPDATE: Only admins can edit global word properties (term, pronunciation, audioUrl).
      allow update: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // DELETE: No one should delete global words to prevent breaking references.
      allow delete: if false;
    }
    
    // User-Specific Collections: Data tied directly to a user.
    function isOwner(collectionName) {
      return request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    function isCreatingOwner(collectionName) {
        return request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /userVocabulary/{docId} {
      allow read, delete: if isOwner('userVocabulary');
      allow create: if isCreatingOwner('userVocabulary');
      allow update: if isOwner('userVocabulary');
    }

    match /lessons/{docId} {
      allow read, delete: if isOwner('lessons');
      allow create: if isCreatingOwner('lessons');
      allow update: if isOwner('lessons');
    }
    
    match /testResults/{docId} {
      allow read, delete: if isOwner('testResults');
      allow create: if isCreatingOwner('testResults');
      allow update: if isOwner('testResults');
    }

    match /user_activity/{docId} {
       allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
       // Allow create/update if the docId starts with the user's UID.
       // This is more secure for set({merge: true}) operations.
       allow write: if request.auth != null && docId.startsWith(request.auth.uid);
    }
  }
}
