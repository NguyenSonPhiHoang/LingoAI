rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only update their own profile information.
    // Admins can update anyone's profile (e.g., to approve them).
    // Any authenticated user can read profile data (e.g., for display names).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId 
                    || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Any authenticated user can read the global list of words.
    // This is necessary to get term and pronunciation info.
    match /words/{wordId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User-specific vocabulary data.
    // List operations are restricted to queries filtered by the user's own ID.
    // Document operations are restricted to the owner of that document.
    match /userVocabulary/{docId} {
       allow list: if request.auth != null && request.query.where.size == 1 && request.query.where[0].field == 'userId' && request.query.where[0].value == request.auth.uid;
       allow read, create, update, delete: if request.auth.uid == resource.data.userId;
    }
    
    // Lessons are private to the user who created them, but admins can access them.
    match /lessons/{lessonId} {
        allow read, write: if request.auth.uid == resource.data.userId 
                          || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
  }
}