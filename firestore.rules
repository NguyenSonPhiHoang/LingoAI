
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // USER-OWNED DATA: 
    // This rule applies to all collections that store data belonging to a specific user.
    // It's based on the excellent general-purpose rule you suggested.
    match /{path=**}/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // SPECIFIC COLLECTION RULES:
    
    // Users Collection:
    // - Allow users to read and update their own document.
    // - Allow new users to create their own document upon signup.
    // - Admins can read/write any user document.
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      allow list: if isAdmin(); // Only admins can list all users
    }

    // Global Words Collection:
    // - All authenticated users can read.
    // - Only admins can write (create/update/delete).
    match /words/{wordId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Learning Resources Collection:
    // - All authenticated users can read.
    // - Admins can write.
    // - Authenticated users can update (for rating).
    match /learningResources/{resourceId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if request.auth != null; // Allows users to rate
    }

    // The following collections contain user-specific data.
    // The rule allows a user to read/write their OWN documents.
    // This covers create, get, list, update, delete operations correctly.
    match /lessons/{lessonId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    match /storybooks/{storybookId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }

    match /userVocabulary/{userVocabId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }

    match /library/{docId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }

    match /library_content/{contentId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    match /testResults/{resultId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    match /user_activity/{activityId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }
  }
}
