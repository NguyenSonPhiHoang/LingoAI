rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS: Can read/update their own profile
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
    }

    // GLOBAL: Authenticated users can read, admins can write
    match /words/{wordId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /learningResources/{resourceId} {
      allow read: if request.auth != null;
      // Allow write for admins, and update for any authenticated user (for rating)
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if request.auth != null;
    }
    
    // USER-OWNED CONTENT: User can read/write their own documents.
    // This single rule applies to get, list, create, update, delete.
    match /storybooks/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /lessons/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /userVocabulary/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /library/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /library_content/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /testResults/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
     match /user_activity/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
