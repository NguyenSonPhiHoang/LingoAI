rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can read/update their own info
    match /users/{userId} {
      allow read, update: if isOwner(userId);
    }

    // Global data, readable by any authenticated user
    match /words/{wordId} {
      allow read: if request.auth != null;
    }
    match /learningResources/{resourceId} {
        allow read: if request.auth != null;
        // Allow any logged-in user to rate
        allow update: if request.auth != null;
    }

    // User-specific collections
    match /userVocabulary/{docId} {
      allow get, write: if isOwner(resource.data.userId);
      allow list: if request.auth != null && request.query.where.get('userId')[2] == request.auth.uid;
    }
    match /lessons/{docId} {
      allow get, write: if isOwner(resource.data.userId);
      allow list: if request.auth != null && request.query.where.get('userId')[2] == request.auth.uid;
    }
    match /storybooks/{docId} {
      allow get, write: if isOwner(resource.data.userId);
      allow list: if request.auth != null && request.query.where.get('userId')[2] == request.auth.uid;
    }
     match /library/{docId} {
      allow get, write: if isOwner(resource.data.userId);
      allow list: if request.auth != null && request.query.where.get('userId')[2] == request.auth.uid;
    }
     match /library_content/{docId} {
      allow get, write: if isOwner(resource.data.userId);
      allow list: if request.auth != null && request.query.where.get('userId')[2] == request.auth.uid;
    }
    match /testResults/{docId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow list: if request.auth != null && request.query.where.get('userId')[2] == request.auth.uid;
    }
     match /user_activity/{docId} {
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow list: if request.auth != null && request.query.where.get('userId')[2] == request.auth.uid;
    }
  }
}
