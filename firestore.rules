
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if the user is the owner of the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Allow read for any authenticated user
      allow read: if isAuthenticated();
      
      // Allow create for any user (during signup)
      allow create: if true;
      
      // Allow update only for the owner of the document or an admin
      allow update: if isOwner(userId) || isAdmin();
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    match /lessons/{lessonId} {
      // Users can read, create, update, and delete their own lessons.
      allow read, write: if isOwner(request.resource.data.userId);
      // Admins can read any lesson (e.g., for support)
      allow get: if isAdmin();
    }
    
    match /words/{wordId} {
      // Any authenticated user can read the global word list.
      allow read: if isAuthenticated();
      // Only admins can create, update, or delete global words.
      allow write: if isAdmin();
    }
    
    match /userVocabulary/{userVocabularyId} {
       // Users can read, create, update, and delete their own vocabulary entries.
      allow read, write: if isOwner(request.resource.data.userId);
       // Admins can read any user's vocabulary (e.g., for moderation)
      allow get: if isAdmin();
    }
  }
}
