rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // USER DATA: Users can update their own info. Only admins can see the full list.
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
      // allow list: if request.auth.token.role == 'admin'; // For future admin functionality
    }

    // SHARED RESOURCES: Any authenticated user can read, only admin can write.
    match /words/{wordId} {
      allow read: if request.auth.uid != null;
      allow write: if request.auth.token.role == 'admin';
    }
    match /learningResources/{resourceId} {
      allow read: if request.auth.uid != null;
      allow write: if request.auth.token.role == 'admin';
    }

    // USER-OWNED COLLECTIONS: Users can only CUD their own documents, and can only read their own.
    // This rule applies to get (single doc) and list (query) operations.
    // Firestore ensures that any query will only return documents that match this condition.
    match /lessons/{lessonId} {
      allow read, write: if request.auth.uid == request.resource.data.userId;
    }
    match /userVocabulary/{vocabId} {
      allow read, write: if request.auth.uid == request.resource.data.userId;
    }
     match /storybooks/{storybookId} {
      allow read, write: if request.auth.uid == request.resource.data.userId;
    }
     match /library/{docId} {
      allow read, write: if request.auth.uid == request.resource.data.userId;
    }
    match /library_content/{contentId} {
      allow read, write: if request.auth.uid == request.resource.data.userId;
    }
    match /testResults/{resultId} {
      allow read, write: if request.auth.uid == request.resource.data.userId;
    }
    match /user_activity/{activityId} {
      allow read, write: if request.auth.uid == request.resource.data.userId;
    }
  }
}
