rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    match /words/{wordId} {
      allow get, list, create: if isAuth();
      allow update, delete: if isAdmin();
    }

    match /userVocabulary/{docId} {
      // Allow creation if the user is the owner of the new data.
      allow create: if isOwner(request.resource.data.userId);
      // Allow read and delete if the user is the owner of the existing data.
      allow read, delete: if isOwner(resource.data.userId);
      // Allow update if the user is the owner of the existing data.
      // This prevents errors on logout, as resource.data won't exist for a new write.
      allow update: if isOwner(resource.data.userId);
    }
    
    match /lessons/{lessonId} {
      allow read, write: if isAuth() &&
                           (isOwner(resource.data.userId) || isOwner(request.resource.data.userId));
    }
    
    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read: if isOwner(userId) || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
