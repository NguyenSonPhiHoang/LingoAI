rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    // Checks if the requesting user has the 'admin' role.
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Checks if the user is the owner of the document.
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Collection: users ---
    // User profiles, roles, and status.
    match /users/{userId} {
      // READ: Admins can get any user. Users can only get their own profile.
      allow get: if isOwner(userId) || isAdmin();
      // LIST: Only admins can list all users.
      allow list: if isAdmin();
      
      // CREATE: Any authenticated user can create their own profile document.
      // Must set role to 'user' and status to 'pending' on creation.
      allow create: if isOwner(userId) &&
                       request.resource.data.role == 'user' &&
                       request.resource.data.status == 'pending';
                       
      // UPDATE: Users can update their own displayName/photoURL.
      // Admins can update anyone's 'status'.
      // Nobody can change the 'role'.
      allow update: if isOwner(userId) &&
                       request.resource.data.displayName == resource.data.displayName &&
                       request.resource.data.photoURL == resource.data.photoURL;
      allow update: if isAdmin() &&
                       request.resource.data.status != resource.data.status;
    }
    
    // --- Collection: words (Global Vocabulary) ---
    // The master list of all vocabulary terms.
    match /words/{wordId} {
      // READ/CREATE: Any authenticated user can read or create a new global word.
      allow read, create: if request.auth.uid != null;
      // UPDATE: Only admins can edit a global word's core properties.
      allow update: if isAdmin();
    }
    
    // --- User-Specific Data Collections ---
    // These collections contain data tied to a specific userId.
    
    match /userVocabulary/{docId} {
      allow read, write, delete: if isOwner(resource.data.userId);
    }

    match /lessons/{docId} {
      allow read, write, delete: if isOwner(resource.data.userId);
    }
    
    match /library/{docId} {
      allow read, write, delete: if isOwner(resource.data.userId);
    }
    
    match /testResults/{docId} {
      allow read, create: if isOwner(request.resource.data.userId);
    }
    
    match /user_activity/{docId} {
      // Activity documents are named `userId_YYYY-MM-DD`.
      allow write: if isOwner(docId.split('_')[0]);
      allow read: if isOwner(resource.data.userId);
    }
    
    // --- Default Deny ---
    // Explicitly deny access to any path not defined above.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}