
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Admins can list all users.
      allow list: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Users can only read their own data. Admins can read anyone's data.
      allow read: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Anyone can create a user doc for themselves, but role must be 'user' and status 'pending'
      allow create: if request.auth.uid == userId &&
                      request.resource.data.role == 'user' &&
                      request.resource.data.status == 'pending';
      
      // Users can update their own displayName and photoURL.
      // Admins can update anyone's status.
      allow update: if (request.auth.uid == userId &&
                       request.resource.data.keys().hasOnly(['displayName', 'photoURL']))
                    || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
                        request.resource.data.keys().hasOnly(['status']));
    }

    match /words/{wordId} {
      // Words can be read/created by any authenticated user.
      allow read, create: if request.auth.uid != null;
      // Global words can only be updated by admins.
      allow update: if request.auth.uid != null &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User-specific collections are protected by userId.
    match /userVocabulary/{docId} {
      allow read, write, delete: if request.auth.uid != null && request.auth.uid == resource.data.userId;
    }
    match /lessons/{docId} {
        allow read, write, delete: if request.auth.uid != null && request.auth.uid == resource.data.userId;
    }
    match /testResults/{docId} {
        allow read, write, delete: if request.auth.uid != null && request.auth.uid == resource.data.userId;
    }
    match /user_activity/{docId} {
        allow read, write, delete: if request.auth.uid != null && request.auth.uid == resource.data.userId;
    }
  }
}
