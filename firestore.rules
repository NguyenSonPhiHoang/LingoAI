rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- User Profile Rules ---
    // A user can create their own profile upon signup.
    // A user can read, update their own profile.
    // Admins can read any profile.
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow create: if request.auth.uid == userId;
    }

    // --- Personal Data Rules ---
    // The following collections contain user-specific data.
    // The rule is simple: a user can do anything (read, write) to a document
    // if their UID matches the 'userId' field in that document.
    // This works for get, list, create, update, delete as long as client queries filter by userId.

    match /lessons/{docId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }

    match /storybooks/{docId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }

    match /library/{docId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }

    match /library_content/{docId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }

    match /userVocabulary/{docId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    match /testResults/{docId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }

    match /user_activity/{docId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }

    // --- Global Data Rules ---
    // These collections contain public or semi-public data.

    // All authenticated users can read global words. Only admins can create/update them.
    match /words/{docId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // All authenticated users can read learning resources. Only admins can write.
    match /learningResources/{docId} {
       allow read: if request.auth != null;
       allow create, delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
       // Allow any authenticated user to update (for rating)
       allow update: if request.auth != null;
    }
  }
}