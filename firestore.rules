rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read public user data, but only update their own.
    // Admins can update any user's status.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow update: if request.auth.uid == userId // Allow user to update their own info (displayName, etc.)
                    || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' && 'status' in request.resource.data); // Allow admin to update status
    }

    // Words are global. Authenticated users can read and create them (when adding a new term).
    // Only admins can update existing words.
    match /words/{wordId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can only manage their own vocabulary entries.
    match /userVocabulary/{docId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Users can only manage their own lessons.
    match /lessons/{lessonId} {
       allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
       allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
       allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Users can only manage their own test results.
    match /testResults/{resultId} {
       allow read, create: if request.auth != null && request.resource.data.userId == request.auth.uid;
       // Test results are immutable
       allow update, delete: if false;
    }
    
    // Users can only record their own activity.
    match /user_activity/{activityId} {
      allow read, create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Activity records are not deletable by clients
      allow delete: if false;
    }
  }
}
