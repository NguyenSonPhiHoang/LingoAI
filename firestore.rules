rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requesting user is an admin.
    // This function reads the user's own document from the 'users' collection.
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- USER Collection Rules ---
    // Controls access to user profile data, roles, and status.
    match /users/{userId} {
      // GET (Read single document):
      // - An admin can get any user's document.
      // - A non-admin user can only get their own document.
      allow get: if isAdmin() || request.auth.uid == userId;

      // LIST (Query collection):
      // - Only admins can list multiple users.
      allow list: if isAdmin();

      // CREATE:
      // - Any authenticated user can create their own user document.
      // - They cannot assign themselves as 'admin'.
      // - Their initial status must be 'pending'.
      allow create: if request.auth.uid == userId
                    && request.resource.data.role == 'user'
                    && request.resource.data.status == 'pending';

      // UPDATE:
      // - Admins can update the 'status' of any user.
      // - Users can only update their own 'displayName' and 'photoURL'. They cannot change their role or status.
      allow update: if (isAdmin() && 'status' in request.resource.data)
                    || (request.auth.uid == userId && !('role' in request.resource.data) && !('status' in request.resource.data));
    }

    // --- WORDS Collection Rules ---
    // This is the global vocabulary list.
    match /words/{wordId} {
      // READ/CREATE: Any authenticated user can read or create (by adding a new word).
      allow read, create: if request.auth.uid != null;
      // UPDATE: Only admins can modify existing global words.
      allow update: if isAdmin();
    }
    
    // --- Generic Rules for User-Owned Data ---
    // This pattern applies to collections where each document belongs to a specific user.
    match /{collectionName}/{docId}
      where collectionName in ['userVocabulary', 'lessons', 'library', 'testResults', 'user_activity'] {
        allow read, write, delete: if request.auth.uid == resource.data.userId;
        allow create: if request.auth.uid == request.resource.data.userId;
    }
  }
}
