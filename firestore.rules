
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // By default, deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS
    // Allow users to read their own document and update their display name.
    // Admins can do anything.
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']);
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // LESSONS
    // Users can CUD their own lessons, and read them.
    match /lessons/{lessonId} {
      allow read, delete, update: if resource.data.userId == request.auth.uid;
      allow create: if request.resource.data.userId == request.auth.uid;
    }

    // USER VOCABULARY
    // Users can CUD their own vocabulary entries.
    match /userVocabulary/{userVocabId} {
        allow read, delete, update: if resource.data.userId == request.auth.uid;
        allow create: if request.resource.data.userId == request.auth.uid;
    }
    
    // STORYBOOKS
    // Users can CUD their own storybooks.
    match /storybooks/{storybookId} {
        allow read, delete, update: if resource.data.userId == request.auth.uid;
        allow create: if request.resource.data.userId == request.auth.uid;
    }

    // LIBRARY & LIBRARY_CONTENT
    // Users can CUD their own library documents and their content.
    match /library/{docId} {
        allow read, delete, update: if resource.data.userId == request.auth.uid;
        allow create: if request.resource.data.userId == request.auth.uid;
    }
     match /library_content/{contentId} {
        allow read, delete, update: if resource.data.userId == request.auth.uid;
        allow create: if request.resource.data.userId == request.auth.uid;
    }

    // TEST RESULTS & ACTIVITY
    // Users can create and read their own test results and activity logs. No edits/deletes.
    match /testResults/{resultId} {
      allow read: if resource.data.userId == request.auth.uid;
      allow create: if request.resource.data.userId == request.auth.uid;
    }
     match /user_activity/{activityId} {
      allow read: if resource.data.userId == request.auth.uid;
      allow create, update: if request.resource.data.userId == request.auth.uid; // Update is needed for increment
    }

    // --- Global Collections ---

    // WORDS
    // All authenticated users can read global words. Only admins can create/update them.
    match /words/{wordId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // LEARNING RESOURCES
    // All authenticated users can read. Admins can CUD. Users can rate (update).
    match /learningResources/{resourceId} {
        allow read: if request.auth != null;
        allow create, delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        // Allow rating by any authenticated user
        allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratings', 'ratingCount', 'averageRating']);
    }
  }
}
