rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users Collection
    match /users/{userId} {
      // Any authenticated user can read their own document. Admins can read any user document.
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      // Only the user themselves can update their profile. Admins can update any user's status/role.
      allow update: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      // Only allow user creation through the signup flow.
      allow create: if request.auth != null;
    }

    // Words Collection (Global)
    match /words/{wordId} {
      // Any authenticated user can read the global word list.
      allow read: if request.auth != null;
      // Any authenticated user can create a new word if it doesn't exist.
      allow create: if request.auth != null;
      // Only admins can update global words.
      allow update: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User-specific Vocabulary Collection
    match /userVocabulary/{userVocabId} {
      // A user can do anything with their own vocabulary entries.
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      // Any authenticated user can create a new vocabulary entry for themselves.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Lessons Collection
    match /lessons/{lessonId} {
      // A user can read, create, and update their own lessons.
      allow read, create, update: if request.auth != null && request.auth.uid == resource.data.userId;
      // A user can delete their own lessons.
      allow delete: if request.auth.uid == resource.data.userId;
    }
    
    // Learning Resources Collection
    match /learningResources/{resourceId} {
      // Any authenticated user can read resources and submit/update their own rating.
      allow read: if request.auth != null;
      // Admins can create, update, and delete resources.
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Test Results Collection
    match /testResults/{resultId} {
        // A user can read and create their own test results.
        allow read, create: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // User Activity Collection
    match /user_activity/{activityId} {
        // A user can read and create their own activity entries.
        allow read, create, update: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Library Collection (Main Documents)
    match /library/{docId} {
      // A user can read, create, update, and delete their own library documents.
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Library Content Collection (Notes)
    match /library_content/{contentId} {
      // A user can read, create, update, and delete their own notes.
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}