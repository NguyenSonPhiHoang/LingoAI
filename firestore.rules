
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check for admin role
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      allow get: if request.auth.uid != null;
      allow list: if isAdmin();
      allow create: if request.auth.uid == userId 
                    && request.resource.data.role == 'user'
                    && request.resource.data.status == 'pending';
      allow update: if request.auth.uid == userId || isAdmin();
      // Allow users to update their own info, but not role or status
      // Allow admins to update anyone's status, but not role
      allow update: if (request.auth.uid == userId && !('role' in request.resource.data) && !('status' in request.resource.data))
                    || (isAdmin() && !('role' in request.resource.data));
    }
    
    // Rules for the 'words' collection (global vocabulary)
    match /words/{wordId} {
      allow read: if request.auth.uid != null;
      // Only admins can create or modify global words
      allow write: if isAdmin();
    }
    
    // Rules for the 'userVocabulary' collection
    match /userVocabulary/{userVocabId} {
      // Users can only access their own vocabulary entries
      allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    // Rules for the 'lessons' collection
    match /lessons/{lessonId} {
        allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    // Rules for the 'library' collection
    match /library/{docId} {
        allow read, write: if request.auth.uid == resource.data.userId;
    }

    // Rules for 'learningResources' collection
    match /learningResources/{resourceId} {
        allow read: if request.auth.uid != null;
        allow create, delete: if isAdmin();
        // Allow authenticated users to update ratings, but nothing else.
        allow update: if request.auth.uid != null
                      // Ensure no other top-level fields are being changed
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['ratings', 'ratingCount', 'averageRating'])
                      // Ensure user is only changing their own rating
                      && request.resource.data.ratings.diff(resource.data.ratings).affectedKeys()
                         .hasOnly([request.auth.uid]);
    }
    
    // Rules for test results
    match /testResults/{resultId} {
        allow read, create: if request.auth.uid == resource.data.userId;
        // Generally, results are immutable
        allow update, delete: if false;
    }

    // Rules for user activity tracking
    match /user_activity/{activityId} {
        allow read: if request.auth.uid == resource.data.userId || isAdmin();
        allow write: if request.auth.uid != null 
                     && request.auth.uid == request.resource.data.userId;
    }
  }
}
