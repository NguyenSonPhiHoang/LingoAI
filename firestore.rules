
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow user to read their own data, or any admin to read any user data
      allow get: if isOwner(userId) || isAdmin();
      
      // Allow anyone to create their own user document (on signup)
      allow create: if isOwner(userId);
      
      // Allow user to update their own data, or admin to update any user's status
      allow update: if (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL'])) || 
                       (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));

      // Only admins can delete users (for future use)
      allow delete: if isAdmin();
    }
    
    // Rules for the 'words' collection (global vocabulary)
    match /words/{wordId} {
        // Any authenticated user can read the global words
        allow get: if request.auth != null;
        // Only admins can create, update, or delete global words
        allow list, create, update, delete: if isAdmin();
    }
    
    // Rules for the 'userVocabulary' collection
    match /userVocabulary/{userVocabId} {
        // User can read, create, update, delete their own vocabulary entries
        allow read, create, update, delete: if request.auth.uid == request.resource.data.userId;
        // Allow list only for the owner
        allow list: if request.auth.uid == request.query.where.value;
    }
    
    // Rules for the 'lessons' collection
    match /lessons/{lessonId} {
       // User can read, create, update, delete their own lessons
       allow read, create, update, delete: if request.auth.uid == request.resource.data.userId;
       // Allow list only for the owner
       allow list: if request.auth.uid == request.query.where.value;
    }

    // Rules for the 'testResults' collection
    match /testResults/{resultId} {
        // User can create their own test results
        allow create: if request.auth.uid == request.resource.data.userId;
        // User can read their own test results, admins can read all
        allow get: if request.auth.uid == resource.data.userId || isAdmin();
        allow list: if request.auth.uid == request.query.where.value || isAdmin();
    }
    
    // Rules for the 'user_activity' collection
    match /user_activity/{activityId} {
        // User can create and update their own activity log.
        // The document ID is structured as `${userId}_${date}`
        allow create, update: if request.auth.uid == resource.data.userId && request.auth.uid == activityId.split('_')[0];
        // User can read their own activity logs. Admins can read all.
        allow get: if request.auth.uid == resource.data.userId || isAdmin();
        // Allow list only for the owner or an admin.
        allow list: if (request.query.where.field == 'userId' && request.query.where.value == request.auth.uid) || isAdmin();
    }
  }
}
