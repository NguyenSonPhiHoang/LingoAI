rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Default secure: Deny all reads and writes by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can read and update their own user document.
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
    }
    
    // Admins can read all user docs.
    match /users/{userId} {
      allow list: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Shared resources can be read by any authenticated user, but only written by admins.
    match /words/{wordId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /learningResources/{resourceId} {
       allow read: if request.auth != null;
       allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // User-specific data can only be accessed by the owner.
    // This simple rule covers create, get, list, update, delete as long as the
    // client-side queries correctly filter by userId.
    match /userVocabulary/{docId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    match /lessons/{docId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    match /library/{docId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    match /library_content/{docId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    match /testResults/{docId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }
    
    match /user_activity/{docId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }

    // Storybooks are personal resources, only the owner can read/write them.
    match /storybooks/{docId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }
  }
}