rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Allow users to manage their own profile information
    match /users/{userId} {
      // Any authenticated user can read user profiles (e.g., for display names)
      allow read: if request.auth != null;
      // Users can only create their own user document
      allow create: if isOwner(userId);
      // Users can only update their own document
      allow update: if isOwner(userId);
    }

    // Rules for user-specific data collections.
    // The user must be authenticated and their UID must match the 'userId' field in the document.
    match /storybooks/{docId} {
      allow read, write: if isOwner(resource.data.userId);
    }
    match /lessons/{docId} {
      allow read, write: if isOwner(resource.data.userId);
    }
    match /userVocabulary/{docId} {
      allow read, write: if isOwner(resource.data.userId);
    }
    match /library/{docId} {
      allow read, write: if isOwner(resource.data.userId);
    }
    match /library_content/{docId} {
      allow read, write: if isOwner(resource.data.userId);
    }
    match /testResults/{docId} {
       allow read, create: if isOwner(request.resource.data.userId);
       allow update, delete: if isOwner(resource.data.userId);
    }
    match /user_activity/{docId} {
       allow read, write: if isOwner(resource.data.userId);
    }

    // Rules for global data collections
    match /words/{wordId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }
    match /learningResources/{resourceId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }
  }
}
